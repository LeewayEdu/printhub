# PrintHub environment variables
# Copy to .env.local for local work, and set the same names in Vercel (Project > Settings > Environment Variables).
# Placeholders only. Never commit real values. This list matches what the code reads (see docs/release-runbook.md, section 3).
#
# Legend
#   BUILD+RUNTIME : the production build fails if it is missing, and the app needs it at runtime
#   RUNTIME       : the build succeeds without it, but the feature fails or is closed until it is set
#   OPTIONAL      : has a safe default (off or unset)

# ---- Supabase (BUILD+RUNTIME) ----
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Email (BUILD+RUNTIME) ----
RESEND_API_KEY=your-resend-api-key

# ---- Paystack (RUNTIME) ----
# Test keys (pk_test_ / sk_test_) on previews; live keys only in Production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ---- Site address (RUNTIME) ----
# The public address. Used by the Paystack webhook notification and the ebook stamping trigger (no fallback there).
NEXT_PUBLIC_SITE_URL=https://your-site-address

# ---- Scheduled jobs (RUNTIME) ----
# A long random string you generate. Without it the reconcile job, design reminders and ebook stamping refuse to run.
CRON_SECRET=a-long-random-string

# ---- Chatbot (RUNTIME) ----
GROQ_API_KEY=your-chatbot-api-key

# ---- C-Chu Books and case studies (OPTIONAL, all off when unset) ----
# "true" shows Books in the menu and footer. Read at build time: redeploy after changing.
BOOKS_NAV_ENABLED=
# "true" shows USD ebook prices outside Nigeria. Turn on only after USD is enabled on Paystack.
BOOKS_USD_ENABLED=
# 16+ characters. Lets you preview an unpublished case study with ?preview=<token>. Unset means no previews.
CASE_STUDY_PREVIEW_TOKEN=
# Random string that salts the hashed network address in the ebook download log. Falls back to the service key.
DOWNLOAD_LOG_SALT=

# ---- Tracking (OPTIONAL) ----
NEXT_PUBLIC_META_PIXEL_ID=

# ---- WhatsApp alerts (OPTIONAL) ----
NOTIFY_PHONE=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
CALLMEBOT_API_KEY=

# ---- Set by the platform or derived, do not set by hand ----
# VERCEL_ENV is set by Vercel. NEXT_PUBLIC_BOOKS_NAV_ENABLED is derived from BOOKS_NAV_ENABLED in next.config.js.

# ---- Leave unset unless told otherwise ----
# PAYSTACK_API_BASE=
# Local development only; ignored in production. Never set on Vercel.
# BOOKS_USE_FIXTURES=
